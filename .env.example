# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Nunca subas el archivo .env con valores reales al repositorio.

# --- Servidor (src/index.js) ---
# Opcional. Por defecto 3000. En Render se asigna automáticamente.
PORT=3000

# --- Base de datos (src/config/db.js) ---
# Obligatorio: define DATABASE_URL, o bien SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# Si DATABASE_URL está definida, tiene prioridad y la API de Supabase se ignora.

# Opción A: conexión directa a PostgreSQL (Supabase u otro).
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres
# Opcional. TLS está activado por defecto; usa false solo para PostgreSQL local sin TLS.
# DB_SSL=false

# Opción B: API REST de Supabase (solo se usa si DATABASE_URL no está definida).
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Notificaciones por correo (src/config/mailer.js, src/routes/solicitudes.js) ---
# Opcional. Si falta cualquiera de estas, la solicitud se guarda pero no se envía correo.
SMTP_HOST=smtp.gmail.com
# 465 usa TLS directo; otros puertos (p. ej. 587) usan STARTTLS.
SMTP_PORT=465
# Cuenta remitente; también se usa en el campo "From".
SMTP_USER=tu-correo@gmail.com
# Con Gmail debe ser una contraseña de aplicación, no la contraseña de la cuenta.
SMTP_PASS=tu-contrasena-de-aplicacion
# Destinatarios de las notificaciones, separados por comas.
ADMIN_EMAILS=admin1@ejemplo.com,admin2@ejemplo.com
